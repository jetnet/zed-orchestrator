# Example .env for the example agents.config files
# Claude (Anthropic) settings
PLAN_ANTHROPIC_MODEL=claude-opus-4-6
PLAN_CLAUDE_CODE_EFFORT_LEVEL=max
CODE_ANTHROPIC_MODEL=claude-opus-4-6
CODE_CLAUDE_CODE_EFFORT_LEVEL=high
REVIEW_ANTHROPIC_MODEL=claude-sonnet-4-6
REVIEW_CLAUDE_CODE_EFFORT_LEVEL=high
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here

# Kilo settings
KILO_PLAN_MODEL=kilo/minimax/minimax-m2.7
KILO_CODE_MODEL=kilo/minimax/minimax-m2.7
KILO_REVIEW_MODEL=kilo/xiaomi/mimo-v2.5-pro
KILO_API_KEY=your_kilo_api_key_here

# Optional OpenRouter (used by opencode examples)
OPENROUTER_API_KEY=your_openrouter_api_key_here
